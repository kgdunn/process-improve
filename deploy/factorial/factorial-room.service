# factori.al's room relay (room_relay.py): it keeps one sealed study for each room, which Caddy passes on from
# /api/room, and hands it back. It never holds a room's key, so it cannot read what it keeps.
#
# Installed as /etc/systemd/system/factorial-room.service by setup.sh, with the relay as /usr/local/bin/factorial-room.
# It needs no settings. It runs as an account systemd makes for it at each start, which can write only to its own
# folder, /var/lib/factorial-rooms (StateDirectory), where it keeps the rooms, a file each.
#
# To remove a room someone reports, from its link: sudo systemctl stop factorial-room is the switch that ends every
# room at once; one room goes with
#     sudo env STATE_DIRECTORY=/var/lib/factorial-rooms factorial-room forget '<the room's link>'

[Unit]
Description=Factorial room relay (factori.al/api/room)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/factorial-room
StateDirectory=factorial-rooms
StateDirectoryMode=0700
Restart=on-failure
RestartSec=5

DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
UMask=0077
TasksMax=64
MemoryMax=128M

[Install]
WantedBy=multi-user.target
