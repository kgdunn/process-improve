# The feedback relay's settings (feedback_relay.py), which systemd reads into its environment
# (factorial-feedback.service). setup.sh copies this file to /etc/factorial/feedback.env when that file is
# missing, and leaves it alone after: fill it in there. The names are the old kgdunn/factorial app's, so its
# values in /home/deploy/factorial/.env can be copied as they are.
#
# The SMTP password is not kept here: it goes, alone, in /etc/factorial/smtp-password.

# The server that sends the site's mail, and the account the relay logs in to it as.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# The address the email comes from: one that account may send as.
SMTP_FROM_EMAIL=
# The maintainer's address: every report goes here, and nowhere else.
FEEDBACK_TO=
